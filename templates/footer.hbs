<footer class="sls-footer">

  <button type="button" data-action="preview">
    <i class="fa-solid fa-eye"></i>
    {{localize "SLS.Preview"}}
  </button>
  <button type="button" data-action="resetDefaults" class="sls-reset-btn" data-tooltip="{{localize 'SLS.ResetDefaultsHint'}}">
    <i class="fa-solid fa-rotate-left"></i>
    {{localize "SLS.ResetDefaults"}}
  </button>
  <button type="button" data-action="saveDefaults" class="sls-save-defaults-btn" data-tooltip="{{localize 'SLS.SaveDefaultsHint'}}">
    <i class="fa-solid fa-star"></i>
    {{localize "SLS.SaveDefaults"}}
  </button>
  <button type="submit">
    <i class="fa-solid fa-save"></i>
    {{localize "SLS.Save"}}
  </button>

</footer>
